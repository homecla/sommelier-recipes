[ "${1:-}" = --machine ] && { MACHINE=1; shift; }
cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  install|i)        cmd_install "$@";;
  update|upgrade|u) cmd_update "$@";;
  uninstall|remove) cmd_uninstall "$@";;
  status|st|list)   cmd_status "$@";;
  default)          cmd_default "$@";;
  bottle|bottles)   cmd_bottle "$@";;
  run)              cmd_run "$@";;
  start)            cmd_start "$@";;
  preset|presets)   cmd_preset "$@";;
  catalog|catalogo) cmd_catalog "$@";;
  winetricks|wt)    cmd_winetricks "$@";;
  kill)             cmd_kill "$@";;
  doctor)           cmd_doctor;;
  rosetta)          cmd_rosetta;;
  version|--version|-v) echo "sommelier $TOOL_VERSION";;
  help|--help|-h)   usage;;
